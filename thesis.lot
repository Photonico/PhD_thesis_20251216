\contentsline {table}{\numberline {5.1}{\ignorespaces Optimized lattice constants, interatomic distances, and band gaps of monolayer \ce {BC3}, borophene, \ce {B4C3}, and graphene. Here, $a$ is the lattice parameter with $a=b$ for all systems, and B-B, C-C, and B-C are the boron-boron, carbon-carbon, and boron-carbon bond lengths, respectively. Borophene and \ce {B4C3} have B-B and B-C bonds of different lengths, which are identified by labels $l_1,\cdots ,l_7$ in figure~\ref {fig1.1}. The band gap $E_{\mathrm {g}}$ is calculated using the PBE and HSE06 exchange-correlation functionals; values in brackets are from previous theoretical studies. ``Nature'' indicates the electronic character of the system.}}{157}{table.caption.18}%
\contentsline {table}{\numberline {5.2}{\ignorespaces Optimized structural properties of each bilayer heterojunction system, including the lowest-energy lateral stacking coordination relative to graphene, the optimized lattice constant $a$, the strains relative to the respective monolayers, $S_{\mathrm {G}}$ and $S_{\mathrm {BC}/\mathrm {B}}$, the interlayer distance $d_{\mathrm {IL}}$, and the electronic nature. Negative and positive percentage strains denote compressive and tensile strains, respectively.}}{158}{table.caption.21}%
\contentsline {table}{\numberline {5.3}{\ignorespaces For each bilayer system and each lateral position considered, the optimized lattice constant, interlayer spacing, total energy, and relative energy are given. The relative energy is given with respect to the most favourable structure, which corresponds to the lowest total energy for each bilayer system.}}{176}{table.caption.39}%
\contentsline {table}{\numberline {6.1}{\ignorespaces Lattice constants, lattice angles, and internal coordinates of bulk o-\ce {B14}~\blx@tocontentsinit {0}\cite {han2023superconducting}.}}{195}{table.caption.57}%
\contentsline {table}{\numberline {6.2}{\ignorespaces Lattice vectors $a$ and $b$, interlayer B-B distance, cohesive energy $E_{\mathrm {c}}$, adsorption energy $E_{\mathrm {ad}}$, and electronic nature of the considered o-\ce {B14} systems. The lattice vectors and interlayer B-B distance are given in \si {\angstrom }, while the cohesive and adsorption energies are given in \si {\electronvolt }.}}{199}{table.caption.60}%
\contentsline {table}{\numberline {7.1}{\ignorespaces Lattice vectors $a$ and $b$, interlayer Be-Be distance, H-Be bond length, hydrogen adsorption energy $E_{\mathrm {ad}}$, angle between the two in-plane lattice vectors, and electronic nature of the hydrogen-functionalized beryllene structures. The lattice vectors, interlayer Be-Be distance, and H-Be bond length are given in \si {\angstrom }, while the adsorption energy is given in \si {\electronvolt }.}}{234}{table.caption.93}%
