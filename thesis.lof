\contentsline {figure}{\numberline {7.29}{\ignorespaces Brillouin zones used for the beryllium structures. Left: Brillouin zone for the hexagonal unit cells of the $\alpha $-, $\beta $-, and 2H-$\alpha $ structures; Right: Brillouin zone for the distorted hexagonal cells of the hydrogen-terminated $\beta $-Beryllene structures.}}{255}{figure.caption.118}%
\contentsline {figure}{\numberline {7.30}{\ignorespaces Band structures of bulk hcp beryllium, $\alpha $-Beryllene, bulk bcc beryllium, and $\beta $-Beryllene.}}{255}{figure.caption.119}%
\contentsline {figure}{\numberline {7.31}{\ignorespaces Reflectivity for the in-plane and out-of-plane directions as function of photon energy for $\alpha $-Beryllene and $\beta $-Beryllene. The in-plane and out-of-plane curves correspond to the $xx$ and $zz$ components, respectively. The reflectivities are evaluated within the effective-medium model described in chapter~\ref {cha:fundamentals_b}.}}{256}{figure.caption.120}%
\contentsline {figure}{\numberline {7.32}{\ignorespaces Energy-loss spectrum for the in-plane and out-of-plane directions as function of photon energy for $\alpha $-Beryllene and $\beta $-Beryllene. The in-plane and out-of-plane curves correspond to the $xx$ and $zz$ components, respectively.}}{256}{figure.caption.121}%
\contentsline {figure}{\numberline {7.33}{\ignorespaces Additional optical spectra for the pristine structures. Upper: refractive index; Middle: reflectivity; Lower: extinction coefficient. The spectra include bulk hcp beryllium, $\alpha $-Beryllene, $\beta $-Beryllene, bulk bcc beryllium, and cubic trilayer beryllene.}}{257}{figure.caption.122}%
\contentsline {figure}{\numberline {7.34}{\ignorespaces Additional optical spectra comparing pristine and hydrogen-functionalized $\alpha $-Beryllene and $\beta $-Beryllene structures. Upper: refractive index; Middle: reflectivity; Lower: extinction coefficient.}}{258}{figure.caption.123}%
