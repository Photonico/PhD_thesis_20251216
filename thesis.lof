\contentsline {figure}{\numberline {6.1}{\ignorespaces Atomic structure of o-\ce {B14}. Panels~(a) and~(b) show two side views of the bulk structure, and panel~(c) shows the corresponding top view. The boron atoms are grouped into G2 (circled in blue), G3 (circled in orange), and G7 (circled in purple), as indicated by the coloured circles in panel~(c) and sketched in panel~(f). These groups correspond to the two-atom, three-atom, and seven-atom groups used in the bonding analysis, respectively. Panels~(d) and~(e) show two side views of the bilayer structure. Panels~(g) and~(h) show two side views of the monolayer structure.}}{196}{figure.caption.56}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Electronic structure of bulk o-\ce {B14}. The upper-left panel shows the calculated band structure along the selected high-symmetry k-path. The upper-right panel gives the Brillouin zone together with the corresponding high-symmetry k-path used for the band-structure calculation. The lower panel shows the projected density of states of bulk o-\ce {B14}, resolved into boron $s$ and $p$ orbital contributions for the atom groups defined in panel~(f) of figure~\ref {fig:ob14_atomic_structure}.}}{197}{figure.caption.58}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Atomic structure of the hydrogen-terminated bilayer o-\ce {B14}. Panel~(a) shows the $3\times 3$ supercell. Panels~(b) and~(d) show two side views, and panel~(c) shows the top view.}}{198}{figure.caption.59}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Phonon dispersion curves for monolayer and bilayer o-\ce {B14}, as calculated from finite differences using a $3\times 3$ supercell.}}{200}{figure.caption.61}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Charge density difference, $\Delta \rho (\vec {r}\,)$, for hydrogen adsorption on the bilayer o-\ce {B14} surface. The charge density difference is calculated using equation~\eqref {charge_density_difference_hydrogen_adsorption} for a $2\times 2$ supercell. Regions of charge accumulation are shown in yellow, and regions of charge depletion are shown in blue. The isosurface level is $1.5\times 10^{-4}~e\,a_0^{-3}$.}}{201}{figure.caption.62}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Band structures of monolayer and bilayer o-\ce {B14} calculated using the HSE06 functional. The left and middle panels show the spin-polarized ferromagnetic and antiferromagnetic configurations of the monolayer, respectively. The right panel shows the band structure of bilayer o-\ce {B14}.}}{202}{figure.caption.63}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces Highest occupied and lowest unoccupied spin-up and spin-down states of the monolayer in the antiferromagnetic state at a k-point midway along the high-symmetry $\mathrm {T}$--$\mathrm {Y}$ direction. The corresponding spin density of the monolayer is also shown. The isosurface levels are $1\times 10^{-7}~e\,\si {\angstrom }^{-3}$ for the state distributions and $0.005~e\,\si {\angstrom }^{-3}$ for the spin density.}}{202}{figure.caption.64}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Band structure and total density of states of the hydrogen-terminated bilayer o-\ce {B14}.}}{203}{figure.caption.65}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Superconducting gap versus temperature for bulk o-\ce {B14} (left) and hydrogen-terminated bilayer o-\ce {B14} (right).}}{204}{figure.caption.66}%
\contentsline {figure}{\numberline {6.10}{\ignorespaces Real and imaginary parts of the dielectric function for the bulk and two-dimensional o-\ce {B14} structures for the two in-plane components $xx$ and $yy$, and the out-of-plane component $zz$.}}{205}{figure.caption.67}%
\contentsline {figure}{\numberline {6.11}{\ignorespaces Absorption coefficient and energy-loss spectrum for the bulk and two-dimensional o-\ce {B14} structures for the in-plane $xx$ and $yy$ directions, and the out-of-plane $zz$ direction.}}{206}{figure.caption.68}%
\contentsline {figure}{\numberline {6.12}{\ignorespaces Reflectivity and refractive index as functions of photon energy for the bulk and two-dimensional o-\ce {B14} structures for the in-plane $xx$ and $yy$ directions, and the out-of-plane $zz$ direction.}}{207}{figure.caption.69}%
\contentsline {figure}{\numberline {6.13}{\ignorespaces Upper: Plane-wave energy cutoff and k-point convergence of the total energy for bulk o-\ce {B14}; Lower: Lattice-constant dependence of the total energy at a plane-wave energy cutoff of \qty {600}{\electronvolt } and a k-point set of $34\times 48\times 31$.}}{212}{figure.caption.70}%
\contentsline {figure}{\numberline {6.14}{\ignorespaces Cohesive energy per atom as a function of plane-wave energy cutoff and k-point set for bulk o-\ce {B14}.}}{213}{figure.caption.71}%
\contentsline {figure}{\numberline {6.15}{\ignorespaces Total energy as a function of vacuum-region thickness.}}{213}{figure.caption.72}%
\contentsline {figure}{\numberline {6.16}{\ignorespaces In-plane and out-of-plane components of the real and imaginary parts of the dielectric function of o-\ce {B14}, calculated with various k-point sets.}}{214}{figure.caption.73}%
\contentsline {figure}{\numberline {6.17}{\ignorespaces In-plane and out-of-plane components of the real and imaginary parts of the dielectric function of bulk o-\ce {B14}, calculated with different numbers of unoccupied states included in the calculation, as denoted by the parameter \texttt {NBANDS}.}}{214}{figure.caption.74}%
\contentsline {figure}{\numberline {6.18}{\ignorespaces Definition of the layer thickness used in the renormalization of the dielectric function, $D_{\mathrm {total}} \mathrel {\mathop :}\mathrel {\mkern -1.2mu}=d_{\mathrm {2D}}$.}}{215}{figure.caption.75}%
\contentsline {figure}{\numberline {6.19}{\ignorespaces Sketch of the hollow-bridge site, indicated by the yellow cross, for the hydrogen adsorption on the monolayer and bilayer structures. The black rectangle represents the unit cell.}}{215}{figure.caption.76}%
\contentsline {figure}{\numberline {6.20}{\ignorespaces Phonon dispersion curves obtained using a $(2\times 2)$ supercell.}}{216}{figure.caption.77}%
\contentsline {figure}{\numberline {6.21}{\ignorespaces Left: Phonon dispersion curves of the monolayer and bilayer calculated using a $3\times 3$ supercell; Right: Phonon dispersion curves of the hydrogen-terminated monolayer and bilayer calculated using a $3\times 3$ supercell. Small negative frequencies appear around the $\Gamma $ point for the hydrogen-terminated bilayer. These small negative frequencies are often found in 2D materials and do not by themselves indicate dynamical instability~\blx@tocontentsinit {0}\cite {liu2016continuum,querne2023crystal,pallikara2022physical}.}}{216}{figure.caption.78}%
\contentsline {figure}{\numberline {6.22}{\ignorespaces Left: Total energy and temperature as functions of time from \textit {ab initio} molecular dynamics calculations for the hydrogen-terminated bilayer at \qty {400}{K}; Right: Top and side views of the molecular structure of the hydrogen-terminated bilayer at the corresponding temperature. The structure remains structurally stable and exhibits only minimal deformation.}}{217}{figure.caption.79}%
\contentsline {figure}{\numberline {6.23}{\ignorespaces Left: Spin-polarized ferromagnetic band structure of the monolayer calculated using the PBE functional; Right: Spin-polarized ferromagnetic band structure of the monolayer calculated using the HSE06 functional.}}{217}{figure.caption.80}%
\contentsline {figure}{\numberline {6.24}{\ignorespaces Total density of states (DoS) of the various structures as calculated using the PBE functional.}}{218}{figure.caption.81}%
\contentsline {figure}{\numberline {6.25}{\ignorespaces Non-spin-polarized band structure of the monolayer calculated using different functionals.}}{218}{figure.caption.82}%
\contentsline {figure}{\numberline {6.26}{\ignorespaces Band structure of the monolayer calculated using a $(2\times 1)$ unit cell. The label ``shifted atoms'' means that, in the initial atomic structure, some atoms were moved slightly away from the ideal high-symmetry sites to break symmetry and allow Jahn--Teller distortions if they were favourable. The structure was subsequently fully relaxed, but the results remained unchanged and displayed no symmetry-lowering distortions.}}{219}{figure.caption.83}%
\contentsline {figure}{\numberline {6.27}{\ignorespaces Fixed-spin energy profile of the monolayer calculated using the PBE+D3 and r$^{2}$SCAN functionals. The relative energy reaches its minimum near a fixed spin moment of $2.0~\mu _{\mathrm {B}}$.}}{219}{figure.caption.84}%
\contentsline {figure}{\numberline {6.28}{\ignorespaces Upper: Spin-resolved total DoS for the FM monolayer structure; Lower: spin-resolved total DoS for the AFM monolayer structure, as calculated using the HSE06 functional.}}{220}{figure.caption.85}%
\contentsline {figure}{\numberline {6.29}{\ignorespaces (a) Highest occupied spin-up state and lowest unoccupied spin-down state of the FM monolayer, taken midway along the high-symmetry $\mathrm {T}$--$\mathrm {Y}$ direction in the Brillouin zone. (b) Corresponding spin density, with an isosurface value of \qty {0.005}{e\per \angstrom \cubed }.}}{220}{figure.caption.86}%
\contentsline {figure}{\numberline {6.30}{\ignorespaces Extinction coefficient as a function of energy for the o-\ce {B14} structures along the $xx$, $yy$, and $zz$ directions. }}{221}{figure.caption.87}%
