\contentsline {figure}{\numberline {1.1}{\ignorespaces Atomic structure of hydrogen-terminated bilayer o-\ce {B14}. Large coloured spheres represent boron atoms, with different colours denoting crystallographically inequivalent boron sites. Small light-purple spheres represent hydrogen atoms. The figure illustrates a computational structural model considered in chapter~\ref {cha:project_boron}.}}{5}{figure.caption.7}%
\contentsline {figure}{\numberline {2.1}{\ignorespaces Schematic illustration of the Hohenberg--Kohn variational picture}}{54}{figure.caption.8}%
\contentsline {figure}{\numberline {3.1}{\ignorespaces Representative real and imaginary parts of the in-plane and out-of-plane dielectric function as a function of photon energy for $\alpha $-Beryllene and $\beta $-Beryllene. The figure illustrates the direction-resolved complex dielectric response discussed in the text. The in-plane and out-of-plane curves correspond to the $xx$ and $zz$ components, respectively. These spectra are from our calculations presented in chapter~\ref {cha:project_beryllene}.}}{114}{figure.caption.9}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces The absorption coefficients for the in-plane and out-of-plane directions as functions of photon energy for $\alpha $-Beryllene and $\beta $-Beryllene. The in-plane and out-of-plane curves correspond to the $xx$ and $zz$ components, respectively. The absorption coefficient is given in $\mathrm {nm}^{-1}$. These spectra are from our calculations presented in chapter~\ref {cha:project_beryllene}.}}{122}{figure.caption.10}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces The refractive indices for the in-plane and out-of-plane directions as functions of photon energy for $\alpha $-Beryllene and $\beta $-Beryllene. The in-plane and out-of-plane curves correspond to the $xx$ and $zz$ components, respectively. These spectra are from our calculations presented in chapter~\ref {cha:project_beryllene}.}}{125}{figure.caption.11}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces The extinction coefficients for the in-plane and out-of-plane directions as functions of photon energy for $\alpha $-Beryllene and $\beta $-Beryllene. The in-plane and out-of-plane curves correspond to the $xx$ and $zz$ components, respectively. These spectra are from our calculations presented in chapter~\ref {cha:project_beryllene}.}}{125}{figure.caption.12}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces The reflectivities for the in-plane and out-of-plane directions as functions of photon energy for $\alpha $-Beryllene and $\beta $-Beryllene. The in-plane and out-of-plane curves correspond to the $xx$ and $zz$ components, respectively. The reflectivities are evaluated within the effective-medium model described in the text. These spectra are from our calculations presented in chapter~\ref {cha:project_beryllene}.}}{128}{figure.caption.13}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces The energy-loss spectra for the in-plane and out-of-plane directions as functions of photon energy for $\alpha $-Beryllene and $\beta $-Beryllene. The in-plane and out-of-plane curves correspond to the $xx$ and $zz$ components, respectively. These spectra are from our calculations presented in chapter~\ref {cha:project_beryllene}.}}{130}{figure.caption.14}%
\contentsline {figure}{\numberline {4.1}{\ignorespaces Schematic distinction between an isolated band subspace and an insulating gap. (a) Global gap, (b) indirect energy overlap, (c) contact between selected and excluded bands, and (d) degeneracy within the selected subspace.}}{136}{figure.caption.15}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Time-reversal invariant momenta in schematic Brillouin zones of (a) triangular and (b) square lattices. Filled points identify inequivalent TRIM; open points mark periodic boundary copies.}}{144}{figure.caption.16}%
\contentsline {figure}{\numberline {5.1}{\ignorespaces Optimized atomic structures of \ce {BC3}, borophene, \ce {B4C3}, and graphene. Green and brown spheres denote boron and carbon atoms, respectively. Borophene has three unique bonds indicated by $l_1$, $l_2$ and $l_3$, while \ce {B4C3} has four unique bonds indicated by $l_4$, $l_5$, $l_6$ and $l_7$. Orange lines highlight the unit cells.}}{156}{figure.caption.17}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Band structures of graphene, borophene, \ce {BC3}, and \ce {B4C3} calculated using PBE (blue) and HSE06 (orange).}}{157}{figure.caption.19}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Top views of the optimized atomic structures of Graphene-\ce {BC3}, Graphene-Borophene, and Graphene-\ce {B4C3}. Green and brown spheres denote boron and carbon atoms, respectively. The orange parallelogram indicates the unit cell.}}{158}{figure.caption.20}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Charge density difference ($\Delta \rho (\vec {r}\,)$, calculated using equation~\ref {charge_density_difference}) between the monolayers and the heterostructures. Regions of charge accumulation are shown in yellow, and regions of charge depletion are shown in blue. The isosurface level is $1.5\times 10^{-4}$ a$_{0}^{-3}$ and the top layer is always graphene.}}{159}{figure.caption.22}%
