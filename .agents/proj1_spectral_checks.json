  "functional": "HSE06",
  "array_layout": "epsilon[cartesian_i, cartesian_j, energy_index, part], part 0 = real; part 1 = imaginary",
  "units": {
    "energy": "eV",
    "epsilon": "dimensionless",
    "loss": "dimensionless",
    "absorption": "nm^-1"
  },
  "formulas": {
    "loss": "epsilon2 / (epsilon1**2 + epsilon2**2)",
    "extinction": "sqrt((hypot(epsilon1, epsilon2) - epsilon1) / 2)",
    "absorption": "2 * energy * extinction / (hbar * c)"
  },
  "constants": {
    "hbar_eV_s": 6.582119569e-16,
    "c_nm_per_s": 2.99792458e+17
  },
  "method": {
    "sub_eV_peaks": "scipy.signal.find_peaks on the full xx loss array, prominence >= 0.01 and minimum separation approximately 0.1 eV; retain 0 <= energy < 1 eV",
    "dominant_out_of_plane_peak": "argmax of zz loss on 14 <= energy <= 20 eV",
    "absorption_maximum": "argmax of xx absorption on 0 <= energy <= 24 eV",
    "negative_intervals": "contiguous epsilon1 < 0 regions; endpoints are linearly interpolated between the adjoining raw energy samples",
    "low_energy_absorption_examples": "linear interpolation of xx absorption at 1, 2, 2.5, 3.5, 5, 8 and 15 eV; no smoothing"
  },
  "scope": [
    "Only the existing HSE06 diagonal xx and zz data are checked; no new electronic-structure calculation is performed.",
    "The loss expression reproduces the scalar diagonal approximation displayed in the figures; this check is not a full-tensor mode analysis.",
    "A local loss peak or a negative real dielectric function alone does not establish a weakly damped plasmon.",
    "No microscopic transition, Dirac-plasmon, pi-plasmon, finite-wave-vector dispersion, or lifetime assignment is inferred from this numerical audit.",
    "The absorption coefficients retain the original supercell dielectric convention and are not newly normalized to an intrinsic sheet quantity."
  ],
